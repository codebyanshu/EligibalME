# Keep the recommendation API private or behind an authenticated server proxy in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCHEME_CSV_PATH=updated_data.csv

# Optional: multilingual semantic retrieval. First launch downloads model weights.
USE_MULTILINGUAL_EMBEDDINGS=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional grounded answer generation. Never put these values in VITE_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_LLM_GENERATION=false
